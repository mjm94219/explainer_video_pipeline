{
 "name": "stack",
 "description": "Layers stacked from top to bottom, each wider than the one above, revealed one at a time and then highlighted in turn. Use for rankings, levels or hierarchies (for example CPU cache, RAM, SSD, hard drive from fast and small to slow and big; layers of software; storage tiers).",
 "params": {
  "layers": "list of 3 to 5 layers, top first, each a short name (1 to 3 words) or an object like {\"name\": \"RAM\", \"note\": \"fast, temporary\"} with a very short note",
  "top_label": "short label above the stack, for example 'Faster, smaller' (optional)",
  "bottom_label": "short label below the stack, for example 'Slower, bigger' (optional)",
  "caption": "short caption shown under the stack (optional)"
 },
 "setup": {
  "layers": "list(P.layers,['Layer one','Layer two','Layer three'],5).map(x=>typeof x==='object'?x:{name:String(x),note:''})",
  "n": "layers.length",
  "endT": "T_IN+n*0.7+0.3"
 },
 "tree": [
  {
   "tag": "div",
   "style": {
    "display": "flex",
    "flex-direction": "column",
    "align-items": "center",
    "gap": "1.6vh",
    "width": "100%"
   },
   "children": [
    {
     "tag": "div",
     "text": "{{P.top_label ? '▲ '+P.top_label : ''}}",
     "style": {
      "font-size": "2.8vh",
      "color": "#9fb3d1",
      "font-weight": "600"
     },
     "bind": {
      "style.opacity": "ease((t-T_IN)/0.6)"
     }
    },
    {
     "each": "layers",
     "as": "L",
     "tag": "div",
     "class": "card",
     "style": {
      "--c": "{{COLORS[i%5]}}",
      "width": "{{(n===1?80:(V?70:56)+i*((V?28:38)/(n-1)))}}%",
      "display": "flex",
      "flex-direction": "column",
      "align-items": "center",
      "gap": ".4vh"
     },
     "frame": {
      "k": "ease((t-T_IN-i*0.7)/0.6)",
      "isLive": "t>endT && Math.floor((t-endT)/1.3)%n===i"
     },
     "bind": {
      "style.opacity": "k",
      "style.transform": "`translateY(${(1-k)*-4}vh) scale(${isLive?1.04:1})`",
      "style.filter": "isLive ? 'brightness(1.35)' : 'none'",
      "style.backgroundImage": "sheen(t,i)"
     },
     "children": [
      {
       "tag": "div",
       "text": "{{String(L.name||'')}}",
       "style": {
        "font-size": "{{V?'4vh':'3.6vh'}}",
        "color": "{{COLORS[i%5]}}",
        "font-weight": "700"
       }
      },
      {
       "tag": "div",
       "if": "L.note",
       "text": "{{String(L.note)}}",
       "style": {
        "font-size": "{{V?'2.8vh':'2.6vh'}}",
        "color": "#cfd9ea",
        "font-weight": "500"
       }
      }
     ]
    },
    {
     "tag": "div",
     "text": "{{P.bottom_label ? '▼ '+P.bottom_label : ''}}",
     "style": {
      "font-size": "2.8vh",
      "color": "#9fb3d1",
      "font-weight": "600"
     },
     "bind": {
      "style.opacity": "ease((t-endT)/0.6)"
     }
    }
   ]
  },
  {
   "tag": "div",
   "class": "cap",
   "text": "{{P.caption||''}}",
   "bind": {
    "style.opacity": "ease((t-endT)/0.6)"
   }
  }
 ]
}