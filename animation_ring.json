{
 "name": "ring",
 "description": "A spinning disc with a ring of tiny magnets pointing one way or the other (1 or 0) and a read/write head. Use for hard drives, magnetic storage or anything stored as two opposite directions.",
 "params": {
  "bits": "a binary string of 6 to 12 digits shown as magnet directions",
  "caption": "short heading above the stored data",
  "one_label": "legend text for a magnet pointing one way",
  "zero_label": "legend text for a magnet pointing the other way",
  "head_label": "short label for the read/write head"
 },
 "setup": {
  "bits": "bitsOf(P.bits,'10110100',12)",
  "n": "bits.length",
  "W": "1000",
  "H": "V?900:560",
  "cx": "V?500:330",
  "cy": "V?330:290",
  "R": "V?280:240",
  "Rm": "R*0.76",
  "ap": "idx=>ease((t-T_IN-0.5-idx*0.12)/0.6)",
  "tx": "V?W/2:760",
  "anchor": "V?'middle':'start'"
 },
 "frame": {
  "k": "ease((t-T_IN)/0.8)",
  "rot": "(t-T_IN)*75",
  "nears": "bits.split('').map((b,i)=>Math.cos((i/n)*2*Math.PI+rot*Math.PI/180+Math.PI/2))",
  "bestV": "Math.max(...nears)",
  "best": "nears.indexOf(bestV)"
 },
 "tree": [
  {
   "tag": "svg",
   "attrs": {
    "viewBox": "0 0 {{W}} {{H}}"
   },
   "style": {
    "width": "100%",
    "max-height": "{{V?'66vh':'60vh'}}"
   },
   "children": [
    {
     "tag": "circle",
     "attrs": {
      "cx": "{{cx}}",
      "cy": "{{cy}}",
      "r": "{{R}}",
      "fill": "rgba(14,22,44,.78)",
      "stroke": "#8fa3c7",
      "stroke-width": 6
     }
    },
    {
     "tag": "g",
     "bind": {
      "attr.transform": "`rotate(${rot} ${cx} ${cy})`"
     },
     "children": [
      {
       "each": "[0.52,0.64,0.88,0.95]",
       "tag": "circle",
       "attrs": {
        "cx": "{{cx}}",
        "cy": "{{cy}}",
        "r": "{{R*item}}",
        "fill": "none",
        "stroke": "rgba(143,163,199,.28)",
        "stroke-width": 2
       }
      },
      {
       "each": 24,
       "tag": "line",
       "vars": {
        "a": "i*Math.PI/12"
       },
       "attrs": {
        "x1": "{{cx+R*.3*Math.cos(a)}}",
        "y1": "{{cy+R*.3*Math.sin(a)}}",
        "x2": "{{cx+R*.46*Math.cos(a)}}",
        "y2": "{{cy+R*.46*Math.sin(a)}}",
        "stroke": "rgba(143,163,199,.35)",
        "stroke-width": 3
       }
      }
     ]
    },
    {
     "tag": "circle",
     "attrs": {
      "cx": "{{cx}}",
      "cy": "{{cy}}",
      "r": "{{R*.14}}",
      "fill": "#8fa3c7",
      "opacity": ".6"
     }
    },
    {
     "tag": "g",
     "bind": {
      "attr.opacity": "k"
     },
     "children": [
      {
       "each": "bits.split('')",
       "as": "b",
       "tag": "polygon",
       "attrs": {
        "points": "0,-26 20,18 -20,18",
        "fill": "{{b==='1'?'#ffd84a':'#7fb6ff'}}",
        "stroke": "#0b1226",
        "stroke-width": 3
       },
       "frame": {
        "a": "(i/n)*2*Math.PI+rot*Math.PI/180",
        "near": "Math.cos(a+Math.PI/2)",
        "sc": "1+0.6*Math.max(0,near-0.8)/0.2"
       },
       "bind": {
        "attr.transform": "`translate(${cx+Rm*Math.cos(a)} ${cy+Rm*Math.sin(a)}) rotate(${a*180/Math.PI+90+(b==='1'?0:180)}) scale(${sc})`"
       }
      }
     ]
    },
    {
     "tag": "g",
     "id": "head",
     "bind": {
      "style.opacity": "ap(0)",
      "attr.transform": "`rotate(${Math.sin(t*2.3)*0.012*57.3} ${cx+R+80} ${cy-R-10})`"
     },
     "children": [
      {
       "tag": "line",
       "attrs": {
        "x1": "{{cx+R+80}}",
        "y1": "{{cy-R-10}}",
        "x2": "{{cx}}",
        "y2": "{{cy-Rm}}",
        "stroke": "#ffa94d",
        "stroke-width": 10,
        "stroke-linecap": "round"
       }
      },
      {
       "tag": "circle",
       "attrs": {
        "cx": "{{cx}}",
        "cy": "{{cy-Rm}}",
        "fill": "#ffa94d"
       },
       "bind": {
        "attr.r": "14+5*Math.max(0,bestV-0.9)/0.1"
       }
      }
     ]
    },
    {
     "tag": "text",
     "attrs": {
      "x": "{{cx+20}}",
      "y": "{{cy-R-26}}",
      "font-size": 28,
      "font-weight": 600,
      "fill": "#ffa94d"
     },
     "text": "{{String(P.head_label||'Read/write head')}}",
     "bind": {
      "style.opacity": "ap(1)"
     }
    },
    {
     "tag": "text",
     "attrs": {
      "x": "{{tx}}",
      "y": "{{V?H-190:150}}",
      "text-anchor": "{{anchor}}",
      "font-size": 32,
      "font-weight": 600,
      "fill": "#fff"
     },
     "text": "{{String(P.caption||'Data stored as tiny magnets')}}",
     "bind": {
      "style.opacity": "ap(2)"
     }
    },
    {
     "tag": "text",
     "attrs": {
      "x": "{{tx}}",
      "y": "{{V?H-130:215}}",
      "text-anchor": "{{anchor}}",
      "font-size": 46,
      "font-weight": 700
     },
     "bind": {
      "style.opacity": "ap(3)"
     },
     "children": [
      {
       "each": "bits.split('')",
       "as": "b",
       "tag": "tspan",
       "text": "{{b+(i<n-1?' ':'')}}",
       "bind": {
        "attr.fill": "(i===best && k>.9) ? '#ffffff' : (b==='1' ? '#ffd84a' : '#7fb6ff')"
       }
      }
     ]
    },
    {
     "tag": "polygon",
     "attrs": {
      "points": "0,-16 12,10 -12,10",
      "fill": "#ffd84a",
      "transform": "{{`translate(${V?160:760} ${V?H-70:300}) rotate(90)`}}"
     },
     "bind": {
      "style.opacity": "ap(4)"
     }
    },
    {
     "tag": "text",
     "attrs": {
      "x": "{{(V?160:760)+30}}",
      "y": "{{(V?H-70:300)+10}}",
      "font-size": 28,
      "fill": "#fff"
     },
     "text": "{{String(P.one_label||'One direction = 1')}}",
     "bind": {
      "style.opacity": "ap(5)"
     }
    },
    {
     "tag": "polygon",
     "attrs": {
      "points": "0,-16 12,10 -12,10",
      "fill": "#7fb6ff",
      "transform": "{{`translate(${V?560:760} ${V?H-70:350}) rotate(-90)`}}"
     },
     "bind": {
      "style.opacity": "ap(6)"
     }
    },
    {
     "tag": "text",
     "attrs": {
      "x": "{{(V?560:760)+30}}",
      "y": "{{(V?H-70:350)+10}}",
      "font-size": 28,
      "fill": "#fff"
     },
     "text": "{{String(P.zero_label||'Opposite direction = 0')}}",
     "bind": {
      "style.opacity": "ap(7)"
     }
    }
   ]
  }
 ]
}